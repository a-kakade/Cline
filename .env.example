BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/sakhi.sqlite
# simulation is allowed ONLY outside production; production uses disabled until a real adapter is implemented.
NOTIFICATION_PROVIDER=simulation
JOB_SECRET=replace-with-at-least-32-random-characters
EMERGENCY_NUMBER=112
# --- Map and nearby services (all optional; defaults shown) ---
# Public Overpass servers are shared and rate limited: fine for development, not for production load.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Identify your deployment to the OSM services (their usage policies require it).
# OVERPASS_USER_AGENT=YourApp/1.0 (contact: you@example.org)
# OSRM public demo returns vehicle routes only and is not for production use.
# OSRM_URL=https://router.project-osrm.org
# Public OSM tiles are for light use only; set your own tile provider for production.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Demo (synthetic) data is hidden in production unless explicitly allowed.
# ALLOW_DEMO_DATA=1
